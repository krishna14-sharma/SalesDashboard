<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- Change Data Source / Initial Catalog / credentials to your SQL Server -->
    <add name="ChickDB" connectionString="Data Source=137.97.174.50,3759;Initial Catalog=PhxGroupERP;User ID=sa;Password=Ph@hoenix#g;"/>
    <!-- SQL login example:
    <add name="ChickDB"
         connectionString="Data Source=SERVER\SQLEXPRESS;Initial Catalog=YourDatabase;User ID=sa;Password=***;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
    -->
  </connectionStrings>
  <appSettings>
    <!-- Shown on the sign-in page. LogoUrl must be an image inside this site, e.g. ~/assets/img/logo.png -->
    <add key="App.Title" value="Chick &amp; Poultry Dashboards"/>
    <add key="App.CompanyName" value=""/>
    <add key="App.LogoUrl" value=""/>
    <!-- How Usertab4.Pwd is stored: AUTO | PWDENCRYPT | SHA2_256 | SHA1 | MD5 | PASSPHRASE | PLAIN
         AUTO tries each in turn. Run Database/06_Login.sql's check once and set the exact method here. -->
    <add key="Login.PasswordMode" value="AUTO"/>
    <!-- User name already filled in on the sign-in page (leave empty for a blank field) -->
    <add key="Login.DefaultUser" value="krishna"/>
    <!-- Only for PASSPHRASE: the key your system used with ENCRYPTBYPASSPHRASE -->
    <add key="Login.Passphrase" value=""/>
    <!-- Comma-separated Usertab4.Role values allowed to sign in. Empty = every role. e.g. "admin,accounts" -->
    <add key="Login.AllowedRoles" value=""/>
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" enableVersionHeader="false"/>
    <customErrors mode="RemoteOnly"/>
    <globalization culture="en-IN" uiCulture="en-IN" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8"/>
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Static"/>
    <!-- Sign-in: every page needs a logged-in user except Login.aspx and the static assets.
         timeout = minutes of inactivity before sign-in is required again.
         Set requireSSL="true" once the site runs on https. -->
    <authentication mode="Forms">
      <forms name=".CHICKDASH" loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" timeout="60" slidingExpiration="true" cookieless="UseCookies" protection="All" requireSSL="false" path="/"/>
    </authentication>
    <authorization>
      <deny users="?"/>
    </authorization>
    <httpCookies httpOnlyCookies="true" sameSite="Lax"/>
  </system.web>
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="assets">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <system.web.extensions>
    <scripting>
      <webServices>
        <!-- allow large JSON responses from the page methods -->
        <jsonSerialization maxJsonLength="50000000"/>
      </webServices>
    </scripting>
  </system.web.extensions>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear/>
        <add value="Default.aspx"/>
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff"/>
        <add name="X-Frame-Options" value="SAMEORIGIN"/>
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>